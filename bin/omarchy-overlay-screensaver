#!/bin/bash
# Control the kjlape.overlay-screensaver shell plugin from anywhere — including
# an ssh login or another TTY, which has no Wayland session of its own.
#
# Talks to the omarchy-shell IPC socket, so it needs no display access.
# `kill` is the failsafe: it restarts the whole omarchy shell, and the overlay
# always starts hidden, so the screen is guaranteed to come back.

set -uo pipefail

# An ssh command runs a non-interactive shell, which never sources ~/.bashrc,
# so the session environment omarchy-shell needs is not set. Rebuild it.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

SHELL_BIN=${OMARCHY_SHELL_BIN:-/usr/bin/omarchy-shell}
TARGET=overlayscreensaver

usage() {
  cat <<'USAGE'
Usage: omarchy-overlay-screensaver <command> [NAME] [--source TAG]

Commands:
  show     Show the overlay (covers everything on every monitor)
  shader   Show the overlay with a GLSL hack instead of the image. NAME
           picks the hack (default: the shell.json `shader` entry, else
           starnest). Unknown names are rejected — nothing is shown.
  shaders  List the available GLSL hacks, one per line
  hide     Hide the overlay
  toggle   Flip it
  status   Print {visible, mode, shader, shaders, image, screens} as JSON
  kill     FAILSAFE: restart the omarchy shell. The overlay starts hidden,
           so this always recovers the screen — even if IPC itself is wedged.

Options:
  --source TAG  Label for the plugin's log line (default: caller info)

Examples:
  omarchy-overlay-screensaver show
  omarchy-overlay-screensaver shader             # default hack
  omarchy-overlay-screensaver shader universeball
  ssh box omarchy-overlay-screensaver hide
  ssh box omarchy-overlay-screensaver kill     # last resort
USAGE
}

default_source() {
  local who=${USER:-$(id -un)}
  local peer=${SSH_CONNECTION:-${SSH_CLIENT:-}}
  if [[ -n $peer ]]; then echo "ssh:${who}@${peer%% *}"; else echo "local:${who}"; fi
}

SOURCE=$(default_source)
SHADER_NAME=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --source) SOURCE=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    shader)
      CMD=$1; shift
      # optional shader name (anything not an option flag)
      if [[ $# -gt 0 && $1 != --* ]]; then SHADER_NAME=$1; shift; fi ;;
    show|shaders|hide|toggle|status|kill) CMD=$1; shift ;;
    *) usage >&2; exit 1 ;;
  esac
done

[[ -n ${CMD:-} ]] || { usage >&2; exit 1; }

# The IPC socket can exit 0 even when the call failed, so surface a clear
# error when the shell is not reachable.
if ! "$SHELL_BIN" shell ping >/dev/null 2>&1; then
  echo "omarchy-overlay-screensaver: omarchy-shell IPC not reachable." >&2
  if [[ $CMD == kill ]]; then
    echo "Falling back to a direct shell restart..." >&2
    exec "$OMARCHY_PATH/bin/omarchy" restart shell 2>/dev/null || systemctl --user restart omarchy-shell.service
  fi
  exit 1
fi

if [[ $CMD == shader ]]; then
  IPC=showShader
  ARGS=("$SHADER_NAME" "$SOURCE")
else
  IPC=$CMD
  ARGS=("$SOURCE")
fi

# Zero-arg methods (shaders, status, kill) never take the source slot, so
# only pass it for the methods that do.
case $CMD in
  hide|toggle|show) ;;
  shaders|status|kill) ARGS=() ;;
esac

# The IPC socket can exit 0 even on failure, so a fallback retry isn't
# enough — surface the plugin's error string when we get one.
RESULT=$("$SHELL_BIN" "$TARGET" "$IPC" "${ARGS[@]}" 2>/dev/null) \
  || RESULT=$("$SHELL_BIN" "$TARGET" "$IPC" 2>/dev/null) \
  || { echo "omarchy-overlay-screensaver: IPC call failed — is the plugin enabled in shell.json?" >&2; exit 1; }

case $CMD in
  show|hide|toggle|shader|kill)
    # these return "ok" or an error string
    if [[ $RESULT != ok ]]; then
      echo "omarchy-overlay-screensaver: ${RESULT:-IPC call failed}" >&2
      exit 1
    fi ;;
  *)
    # status / shaders: the result IS the payload
    if [[ -z $RESULT ]]; then
      echo "omarchy-overlay-screensaver: IPC call failed — is the plugin enabled in shell.json?" >&2
      exit 1
    fi
    echo "$RESULT" ;;
esac